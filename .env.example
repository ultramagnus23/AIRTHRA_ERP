# Copy this file to .env for local development.
# NEVER put real production secrets in this repo. .env is git-ignored.

# --- Postgres / TimescaleDB ---
POSTGRES_USER=airthra
POSTGRES_PASSWORD=change_me_dev_only
POSTGRES_DB=airthra
POSTGRES_PORT=5432
# Full DSN used by alembic / seed scripts (sync, psycopg)
DATABASE_URL=postgresql+psycopg://airthra:change_me_dev_only@localhost:5432/airthra
# Async DSN (asyncpg) used by the future API layer
ASYNC_DATABASE_URL=postgresql+asyncpg://airthra:change_me_dev_only@localhost:5432/airthra

# Roles used for Row-Level-Security (created by the initial migration)
PG_TENANT_ROLE=airthra_tenant
PG_TENANT_PASSWORD=change_me_dev_only_tenant
PG_GLOBAL_ROLE=airthra_global
PG_GLOBAL_PASSWORD=change_me_dev_only_global

# --- Mosquitto ---
MQTT_TLS_PORT=8883
MQTT_DEV_PORT=1883
MQTT_WS_PORT=9001
MQTT_HOST=localhost
# Dev-only plaintext credentials (docker/mosquitto/passwd), see scripts/mosquitto_add_user.sh
MQTT_EDGE_USERNAME=goa_pilot_01_edge
MQTT_EDGE_PASSWORD=change_me_dev_only
MQTT_INGEST_USERNAME=ingest_svc
MQTT_INGEST_PASSWORD=change_me_dev_only

# --- MinIO ---
MINIO_ROOT_USER=airthra_minio
MINIO_ROOT_PASSWORD=change_me_dev_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9090
MINIO_BUCKET=airthra

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_dev_only
GF_PORT=3001

# --- Caddy ---
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# --- P7: admin platform ---
# Shared secret Grafana's alerting webhook must send as X-Webhook-Secret
# when POSTing to /admin/logistics/task (see api/routers/admin_logistics.py -
# Grafana contact points can't mint this app's user JWTs, so a shared
# secret is used for that one endpoint instead).
GRAFANA_WEBHOOK_SECRET=change_me_dev_only_grafana_webhook
# INR per kg SO2 captured, used by workers/billing_worker.py to compute
# invoices.amount. Not specified by the PRD excerpt available to P7 -
# configurable placeholder business rate.
SO2_RATE_PER_KG=45.0
# Billing worker's contractual gap rule for flagged/missing hours:
# "exclude" (default, more defensible - never bills for capture it can't
# evidence) or "trailing_avg" (impute from the trailing 7-day same-hour
# average). See workers/billing_worker.py module docstring.
BILLING_GAP_MODE=exclude
