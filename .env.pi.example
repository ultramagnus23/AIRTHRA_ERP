# Copy to .env.pi on the Raspberry Pi (git-ignored, same convention as
# .env). This is a DIFFERENT, smaller set of variables than the main
# .env.example - the Pi only runs edge/daemon.py, not the whole stack.
#
# Postgres is still only reachable over a private network path (same LAN,
# or a VPN/WireGuard tunnel to the VPS) - it isn't exposed publicly, by
# design, TLS or not. MQTT below now can reach the VPS over the public
# internet once MQTT_USE_TLS=true, since docker-compose.yml's TLS listener
# (8883) is the one publicly bound (the plaintext 1883 listener is
# loopback-only on the server on purpose).

# Manifest source - the Pi reads the sensor manifest directly from
# Postgres (edge/manifest.py's PostgresManifestSource), same as local dev.
DATABASE_URL=postgresql+psycopg://airthra:change_me@your-vps-host:5432/airthra

# --- MQTT ---
MQTT_HOST=your-vps-host
MQTT_EDGE_USERNAME=goa_pilot_01_edge
MQTT_EDGE_PASSWORD=change_me

# Set true for a real field Pi talking to the VPS over the internet; leave
# false only when the Pi is on the same LAN as the broker during bench
# testing/commissioning (then MQTT_DEV_PORT below is used instead, no cert
# needed). See edge/DEPLOY.md's "MQTT connectivity" section.
MQTT_USE_TLS=true
MQTT_TLS_PORT=8883
MQTT_DEV_PORT=1883

# Required when MQTT_USE_TLS=true. This is docker/mosquitto/certs/ca.crt
# from whoever ran gen_certs.sh for the VPS's broker (the dev/pilot
# self-signed CA) - copy that one file to the Pi as ./certs/ca.crt, next
# to docker-compose.pi.yml (NOT ca.key - that stays on whichever machine
# generated it). /app/certs/ca.crt below is where docker-compose.pi.yml
# bind-mounts it to inside the container - don't change this path unless
# you also change that mount.
MQTT_CA_CERT_PATH=/app/certs/ca.crt

# Only needed for full mutual-TLS (client cert auth) - NOT required today,
# since docker/mosquitto/mosquitto.conf has require_certificate false and
# auth still goes through MQTT_EDGE_USERNAME/PASSWORD above. Leave both
# blank unless the broker config is later switched to require client certs.
MQTT_CLIENT_CERT_PATH=
MQTT_CLIENT_KEY_PATH=

# Skips server hostname verification - only for debugging a hostname/CN
# mismatch, never for normal operation (see edge/config.py's docstring on
# this field for what it actually gives up).
MQTT_TLS_INSECURE=false
