# Copy to /etc/airthra-edge.env on the Pi, then: sudo chmod 600 /etc/airthra-edge.env
PLANT_ID=goa_pilot_01
HARDWARE_MODE=real
MAPS_DIR=/opt/airthra-edge/maps
SENSORS_FILE=/opt/airthra-edge/sensors.json
DATA_DIR=/var/lib/airthra-edge
LOCAL_RETENTION_DAYS=7

HMI_ENABLED=true
HMI_PORT=/dev/serial0
HMI_BAUD=115200
HMI_FRAME_GAP_MS=15
# none, lf or crlf. Change only if hmi-probe shows the screen needs it.
HMI_TERMINATOR=none

# Leave MQTT_HOST empty to run the screen and local log without the cloud.
MQTT_HOST=
MQTT_EDGE_USERNAME=
MQTT_EDGE_PASSWORD=
MQTT_USE_TLS=true
MQTT_TLS_PORT=8883
MQTT_CA_CERT_PATH=/etc/airthra-edge-ca.crt
